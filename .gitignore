# Sources only. Everything here is either regenerated by a tool (`npm run
# build`, `tsc -b`, the Netlify CLI) or is private data that belongs on this
# machine: an env file, a chat export, a backup. The relay reads no secret from
# the repo — `VITE_SHARE_PROXY_URL` is a deployment setting, never a committed
# file.

# Dependencies & build outputs
node_modules/
dist/
dist-ssr/
.vite/
*.local
*.tsbuildinfo
.netlify/

# Environment variables & secrets
.env
.env.*
!.env.example

# Personal chat exports, backups & docs
promptpaper-backup-*.json
conversations.json
*.zip
*.pdf
codebase.txt

# Temporary test & reference folders
.scratch/
.verify-tmp/
landing-reference/

# Tool and OS noise. `.output` is what the Netlify CLI writes beside a build;
# `desktop.ini` is the Windows counterpart of `.DS_Store` on this machine.
.output/
*.log
npm-debug.log*
desktop.ini

# Editor, AI tool & OS files
.qoder/
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db
